generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  clients  Client[]
  devis    Devis[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  SYNDIC
  AGENCE_IMMOBILIERE
  AUTRE
}

enum StatutClient {
  PROSPECT
  CLIENT
  INACTIF
  ARCHIVE
}

model Client {
  id        String       @id @default(cuid())
  type      TypeClient   @default(PARTICULIER)
  typeAutre String? // Rempli si type == AUTRE (ex: "Bailleur", "Promoteur")
  statut    StatutClient @default(PROSPECT)

  // Informations Générales (Particulier: Nom de famille / Entreprise: Raison sociale)
  nom           String
  prenom        String? // Seulement pour particulier
  raisonSociale String? // Seulement pour entreprise

  // Coordonnées principales (Particulier ou Entreprise)
  email             String? // Email du particulier ou email de l'entreprise
  telephone         String? // Téléphone fixe du particulier ou de l'entreprise
  telephonePortable String? // Téléphone portable du particulier ou de l'entreprise
  siteWeb           String? // Site web de l'entreprise

  // Adresse
  adresse           String?
  adresseComplement String? // Bâtiment, étage, digicode, etc.
  ville             String?
  codePostal        String?
  pays              String? @default("France")

  // Informations Spécifiques Entreprise/Pro
  siret     String?
  numeroTVA String?

  // Informations Spécifiques Syndic / Agence
  nomImmeubleOuCopropriete String? // Nom de la résidence, de l'immeuble ou du bien géré
  contactSurPlace          String? // Nom du gardien, locataire sur place, etc.
  telSurPlace              String? // Téléphone sur place (loge gardien, locataire)

  // Interlocuteur (Contact principal au bureau : gestionnaire, agent, etc.)
  interlocuteurNomComplet String? // Nom et Prénom de l'interlocuteur
  interlocuteurPoste      String?
  interlocuteurPortable   String?
  interlocuteurEmail      String?

  notes     String?  @db.Text
  userId    String // Permet de relier le client à l'utilisateur qui l'a créé
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  devis Devis[]

  @@index([userId])
  @@map("clients")
}

enum StatutDevis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
}

model Devis {
  id           String      @id @default(cuid())
  numero       String      @unique // Ex: DEV-2023-0001
  dateCreation DateTime    @default(now())
  dateValidite DateTime
  statut       StatutDevis @default(BROUILLON)

  // Montants
  totalHT  Float @default(0)
  totalTVA Float @default(0)
  totalTTC Float @default(0)

  // Informations complémentaires
  notes      String? @db.Text
  conditions String? @db.Text

  // Relations
  clientId String
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lignes   LigneDevis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("devis")
}

model LigneDevis {
  id             String @id @default(cuid())
  description    String @db.Text
  quantite       Float  @default(1)
  prixUnitaireHT Float
  tauxTVA        Float  @default(20.0) // 20.0, 10.0, 5.5, etc.

  // Montants calculés
  totalHT  Float
  totalTVA Float
  totalTTC Float

  ordre Int @default(0) // Pour garder l'ordre des lignes

  // Relation
  devisId String
  devis   Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)

  @@index([devisId])
  @@map("lignes_devis")
}
